{
    "compilerOptions": {
        "noEmit": true,
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "jsx": "react-jsx",
        "allowJs": true,
        "allowImportingTsExtensions": true,
        "skipLibCheck": true,
        "strict": false,
        "noImplicitAny": false,
        "types": ["node"]
    },
    "include": [
        "plugins",
        "node_modules/vendetta-types"
    ]
}